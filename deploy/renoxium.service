[Unit]
Description=Renoxium platform
After=network-online.target
Wants=network-online.target

[Service]
User=renoxium
Group=renoxium
ExecStart=/opt/renoxium/renoxium \
  -addr 127.0.0.1:8080 \
  -data /var/lib/renoxium \
  -base-url https://renoxium.com \
  -apps-domain renoxium.app \
  -trusted-ip-header CF-Connecting-IP \
  -workers 2 \
  -abuse-email abuse@renoxium.com
# Once the journal shows no "running without the kernel sandbox" warning,
# add -require-sandbox above so scripts never run without it.
# -workers 2 suits a 1 GB node; use 4 on 2 GB or more.
# Secrets such as RESEND_API_KEY=... live in this file (mode 600), not here.
EnvironmentFile=-/etc/renoxium/env
Restart=always
RestartSec=2
# Hardening: the process can only write its data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/renoxium
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
# @sandbox allows Landlock, which script workers use to lock themselves
# down. A refused system call fails with EPERM instead of killing the
# process, so a missing entry here degrades instead of taking scripts down.
SystemCallFilter=@system-service @sandbox
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0077
# Leave room for the OS and cloudflared: past this the kernel kills the
# service (it restarts) instead of the whole VPS stalling. Raise on 2 GB+.
MemoryMax=800M
TasksMax=256

[Install]
WantedBy=multi-user.target
